# ── Webshare datacenter (DEFAULT zone) ────────────────────────────────────────
# publicsearch.us is NOT robots/KYC-blocked on Webshare (it is on Bright Data), so the
# recorder scrape defaults to this zone. The IP pool is fetched LIVE from the Webshare
# API and a random US IP is picked per request.
# API token: https://dashboard.webshare.io/userapi/keys (lists the live IP pool)
WEBSHARE_API_TOKEN=
# Proxy username/password (Webshare dashboard > Proxy > Settings)
WEBSHARE_PROXY_USER=
WEBSHARE_PROXY_PASS=

# ── Webshare rotating residential (--zone webshare-residential) ────────────────
# Same account as datacenter, own proxy login. Base username without the -us-rotate suffix.
WEBSHARE_RESIDENTIAL_USER=
WEBSHARE_RESIDENTIAL_PASS=
WEBSHARE_RESIDENTIAL_API_TOKEN=

# ── Bright Data (residential + Web Unlocker) ──────────────────────────────────
# Bright Data API key — REUSE the one in ~/tools/brightdata-cli/.env
# (authenticates the management API: `zones`, `check`, and the Web Unlocker `fetch`).
BRIGHTDATA_API_KEY=

# Bright Data customer id (the "brd-customer-<id>" segment of the proxy username).
# Find it in the dashboard URL or any zone's "Access parameters" tab.
BRIGHTDATA_CUSTOMER_ID=

# Residential rotating zone (superproxy). Create a "Residential" proxy zone at
# https://brightdata.com/cp/zones — the zone NAME goes here, its PASSWORD below.
BRIGHTDATA_RESIDENTIAL_ZONE=
BRIGHTDATA_RESIDENTIAL_PASS=

# Web Unlocker zone NAME (an "Unlocker" / "Web Unlocker" product zone). Used by
# `fetch --zone unlocker`, which POSTs to api.brightdata.com/request. No separate
# password needed (the API key authorizes it).
BRIGHTDATA_UNLOCKER_ZONE=
